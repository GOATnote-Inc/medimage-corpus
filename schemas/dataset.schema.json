{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/GOATnote-Inc/medimage-corpus/schemas/dataset.schema.json",
  "title": "MedImageCorpusDatasetEntry",
  "description": "One manifest line: registry entry for a medical imaging dataset.",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "id",
    "name",
    "modality",
    "anatomy",
    "task_types",
    "size_bytes",
    "license",
    "access_tier",
    "access_url",
    "download_method",
    "year",
    "agent_notes"
  ],
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[a-z0-9][a-z0-9_\\-\\.]*$",
      "description": "Stable lowercase slug; modality prefix optional but recommended."
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "modality": {
      "type": "string",
      "enum": ["CT", "XR", "MRI", "US", "MULTI"]
    },
    "anatomy": {
      "oneOf": [
        { "type": "string", "minLength": 1 },
        {
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "minItems": 1
        }
      ]
    },
    "task_types": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 },
      "minItems": 1,
      "uniqueItems": true
    },
    "size_bytes": {
      "type": ["integer", "null"],
      "minimum": 0
    },
    "license": {
      "type": "string",
      "minLength": 1
    },
    "access_tier": {
      "type": "string",
      "enum": ["open", "registration", "credentialed", "application"]
    },
    "access_url": {
      "type": "string",
      "format": "uri",
      "pattern": "^(https?|s3|gs)://"
    },
    "download_method": {
      "type": "string",
      "enum": [
        "https",
        "s3",
        "aws-open-data",
        "tcia-cli",
        "hf",
        "kaggle",
        "physionet",
        "synapse",
        "openneuro",
        "nih-box",
        "aspera",
        "zenodo",
        "gcs",
        "stanford-aimi",
        "github-release",
        "application"
      ]
    },
    "download_url": {
      "type": ["string", "null"]
    },
    "year": {
      "type": "integer",
      "minimum": 1980,
      "maximum": 2100
    },
    "agent_notes": {
      "type": "string",
      "maxLength": 250
    },
    "mri_sequences": {
      "type": "array",
      "items": { "type": "string" }
    },
    "us_view": {
      "oneOf": [
        { "type": "string", "minLength": 1 },
        {
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "minItems": 1
        }
      ],
      "description": "Ultrasound view(s), e.g. A4C; a single string or a list."
    },
    "license_spdx": {
      "type": ["string", "null"],
      "minLength": 1,
      "description": "SPDX license identifier where one cleanly applies (e.g. CC-BY-NC-SA-4.0). Omitted when the terms are custom, mixed, or per-source."
    },
    "nc": {
      "type": ["boolean", "null"],
      "description": "True when the recorded terms restrict use to non-commercial / research-only; false when a permissive license clearly allows commercial use; absent or null when not determinable from the recorded terms. Derived from license text, not independently verified."
    },
    "num_subjects": {
      "type": ["integer", "null"],
      "minimum": 0
    },
    "checksums_url": {
      "type": ["string", "null"],
      "description": "URL of an upstream-published checksum listing (e.g. a SHA256SUMS file), when the source publishes one. Never fabricated; absent means no checksum source is recorded."
    },
    "image_modalities": {
      "type": "array",
      "items": { "type": "string" }
    },
    "num_pairs": {
      "type": ["integer", "null"],
      "minimum": 0
    },
    "text_type": {
      "oneOf": [
        { "type": "string" },
        {
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "minItems": 1
        }
      ]
    },
    "splits": {
      "type": "object"
    },
    "citations": {
      "type": "array",
      "items": { "type": "string" }
    }
  }
}
